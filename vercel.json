{
    "version": 2,
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/build/index.js"
        },
        {
            "src": "/health",
            "dest": "/build/index.js"
        },
        {
            "src": "/js/(.*)",
            "dest": "/public/js/$1"
        },
        {
            "src": "/css/(.*)",
            "dest": "/public/css/$1"
        },
        {
            "src": "/img/(.*)",
            "dest": "/public/img/$1"
        },
        {
            "src": "/admin-validacion",
            "dest": "/public/html/validacion.html"
        },
        {
            "src": "/(.*)",
            "dest": "/public/html/index.html"
        }
    ]
}
