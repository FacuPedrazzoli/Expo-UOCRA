# ============================================
# Configuración para Supabase + Vercel
# ============================================

# ============================================
# Desarrollo local
# ============================================
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_PORT=5432

# ============================================
# PRODUCCIÓN - Vercel + Supabase
# ============================================
# DATABASE_URL se provee automáticamente en Vercel
# También podés setearla manualmente:

# Ejemplo (NO usar esta, configurar en Vercel):
# DATABASE_URL=postgresql://postgres:[TU-PASSWORD]@db.pkjruovvbqkziulnxqxr.supabase.co:5432/postgres

# Puerto del servidor
PORT=3000
NODE_ENV=development

# Seguridad
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
